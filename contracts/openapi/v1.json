{
  "openapi": "3.1.0",
  "info": {
    "title": "InvenTrack",
    "description": "Sistema de gestión de inventarios para pequeñas empresas.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "infraestructura"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/productos": {
      "get": {
        "tags": [
          "productos"
        ],
        "summary": "Listar",
        "operationId": "listar_productos_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProductoResponse"
                  },
                  "type": "array",
                  "title": "Response Listar Productos Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "productos"
        ],
        "summary": "Crear",
        "operationId": "crear_productos_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CrearProductoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductoResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/productos/{producto_id}": {
      "delete": {
        "tags": [
          "productos"
        ],
        "summary": "Eliminar",
        "operationId": "eliminar_productos__producto_id__delete",
        "parameters": [
          {
            "name": "producto_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Producto Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EliminarProductoResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/inventario/{producto_id}/entradas": {
      "post": {
        "tags": [
          "inventario"
        ],
        "summary": "Registrar Entrada",
        "operationId": "registrar_entrada_inventario__producto_id__entradas_post",
        "parameters": [
          {
            "name": "producto_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Producto Id"
            }
          },
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Correlation-Id"
            }
          },
          {
            "name": "X-Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovimientoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovimientoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Cantidad inválida"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict - Clave de idempotencia reutilizada"
          },
          "503": {
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/inventario/{producto_id}/salidas": {
      "post": {
        "tags": [
          "inventario"
        ],
        "summary": "Registrar Salida",
        "operationId": "registrar_salida_inventario__producto_id__salidas_post",
        "parameters": [
          {
            "name": "producto_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Producto Id"
            }
          },
          {
            "name": "X-Correlation-ID",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Correlation-Id"
            }
          },
          {
            "name": "X-Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MovimientoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovimientoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Cantidad inválida"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict - Stock insuficiente"
          },
          "503": {
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/inventario/{producto_id}": {
      "get": {
        "tags": [
          "inventario"
        ],
        "summary": "Consultar Stock",
        "operationId": "consultar_stock_inventario__producto_id__get",
        "parameters": [
          {
            "name": "producto_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Producto Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Consultar Stock Inventario  Producto Id  Get"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CrearProductoRequest": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre"
        ],
        "title": "CrearProductoRequest"
      },
      "EliminarProductoResponse": {
        "properties": {
          "eliminado_fisicamente": {
            "type": "boolean",
            "title": "Eliminado Fisicamente"
          },
          "desactivado": {
            "type": "boolean",
            "title": "Desactivado"
          },
          "mensaje": {
            "type": "string",
            "title": "Mensaje"
          }
        },
        "type": "object",
        "required": [
          "eliminado_fisicamente",
          "desactivado",
          "mensaje"
        ],
        "title": "EliminarProductoResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MovimientoRequest": {
        "properties": {
          "cantidad": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Cantidad"
          }
        },
        "type": "object",
        "required": [
          "cantidad"
        ],
        "title": "MovimientoRequest"
      },
      "MovimientoResponse": {
        "properties": {
          "producto_id": {
            "type": "string",
            "title": "Producto Id"
          },
          "cantidad": {
            "type": "integer",
            "title": "Cantidad"
          },
          "tipo": {
            "type": "string",
            "title": "Tipo"
          },
          "stock_final": {
            "type": "integer",
            "title": "Stock Final"
          }
        },
        "type": "object",
        "required": [
          "producto_id",
          "cantidad",
          "tipo",
          "stock_final"
        ],
        "title": "MovimientoResponse"
      },
      "ProductoResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
          },
          "activo": {
            "type": "boolean",
            "title": "Activo"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre",
          "activo"
        ],
        "title": "ProductoResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
